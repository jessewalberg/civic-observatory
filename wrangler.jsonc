{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "civic-observatory-stack-local",
  "main": "src/server.ts",
  "compatibility_date": "2026-11-07",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": { "enabled": true },
  "vars": {
    "APP_URL": "http://localhost:3000",
    "OUTBOUND_ENABLED": "false",
    "SCHEDULED_ENABLED": "true"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "civic-observatory-stack-local", "database_id": "00000000-0000-0000-0000-000000000001", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "DOCUMENTS", "bucket_name": "civic-observatory-stack-local-documents" }],
  "triggers": { "crons": ["* * * * *", "*/5 * * * *", "0 7 * * *", "0 8 * * *", "0 8 * * 1"] }
}
