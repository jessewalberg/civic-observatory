{
  "name": "civic-observatory",
  "description": "Municipal meeting summarizer - AI-powered summaries of local government meetings",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate": "node scripts/generate-api.mjs",
    "build": "node scripts/generate-api.mjs && vite build && tsc --noEmit",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "db:local": "wrangler d1 migrations apply DB --local --persist-to .wrangler/state",
    "smoke:local": "node scripts/local-e2e.mjs",
    "smoke:migration": "node scripts/migration-smoke.mjs",
    "import:export": "bun scripts/import-export.ts",
    "infra:staging": "ALCHEMY_STAGE=staging alchemy deploy --stage staging"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.1.12",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tailwindcss/vite": "^4.0.6",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.15",
    "@tanstack/react-router-devtools": "^1.132.0",
    "@tanstack/react-start": "^1.168.24",
    "@tanstack/router-plugin": "^1.132.0",
    "better-auth": "1.7.18",
    "cheerio": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "domhandler": "^5.0.3",
    "effect": "3.19.4",
    "fflate": "^0.8.2",
    "lucide-react": "^0.561.0",
    "motion": "^12.27.5",
    "nanoid": "^5.1.6",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "stripe": "^20.2.0",
    "superjson": "^2.2.2",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.0.6",
    "unpdf": "^1.4.0",
    "vite-tsconfig-paths": "^6.0.2",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@cloudflare/workers-types": "^5.20261107.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "alchemy": "0.94.0",
    "sharp": "^0.34.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.2",
    "vite": "^7.1.7",
    "wrangler": "4.158.0"
  },
  "packageManager": "pnpm@9.15.9"
}
