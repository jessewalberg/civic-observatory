{
	"name": "civic-observatory-docket",
	"private": true,
	"packageManager": "bun@1.4.4",
	"type": "module",
	"scripts": {
		"dev": "vite dev --port 3000",
		"db:local": "wrangler d1 migrations apply DB --local",
		"load": "bun scripts/load-docket.ts",
		"report": "bun scripts/report-docket.ts",
		"signup": "bun scripts/signup-switch.ts",
		"build": "vite build && tsc --noEmit",
		"typecheck": "tsc --noEmit",
		"check": "biome check",
		"format": "biome format",
		"check:docket": "bun scripts/check-docket.ts",
		"check:signup": "bun scripts/check-signup.ts",
		"check:pages": "bun scripts/check-pages.ts",
		"check:limits": "bun scripts/check-limits.ts",
		"check:guard": "bun scripts/check-guard.ts",
		"check:load": "bun scripts/check-load.ts",
		"check:release": "bun scripts/check-release.ts",
		"check:production": "bun scripts/check-production.ts",
		"check:breaks": "bun scripts/check-breaks.ts",
		"screenshots": "bun scripts/screenshots.ts",
		"plan:preview": "ALCHEMY_STAGE=preview ALCHEMY_PROFILE=civic-docket-preview ALCHEMY_TELEMETRY_DISABLED=1 APP_RELEASE=$(git rev-parse HEAD) bun scripts/infra.ts plan",
		"deploy:preview": "ALCHEMY_STAGE=preview ALCHEMY_PROFILE=civic-docket-preview ALCHEMY_TELEMETRY_DISABLED=1 APP_RELEASE=$(git rev-parse HEAD) bun scripts/infra.ts deploy --yes",
		"plan:production": "ALCHEMY_STAGE=production ALCHEMY_PROFILE=civic-docket-production ALCHEMY_TELEMETRY_DISABLED=1 APP_RELEASE=$(git rev-parse HEAD) bun scripts/infra.ts plan",
		"deploy:production:ci": "bun scripts/infra.ts deploy --yes"
	},
	"dependencies": {
		"@tanstack/react-router": "1.170.41",
		"@tanstack/react-start": "1.168.60",
		"effect": "4.1.2",
		"react": "19.2.3",
		"react-dom": "19.2.3"
	},
	"devDependencies": {
		"@alchemy.run/cloudflare": "2.0.0-beta.85",
		"@biomejs/biome": "2.2.4",
		"@cloudflare/vite-plugin": "1.21.0",
		"@cloudflare/workers-types": "4.20260114.0",
		"@effect/platform-bun": "4.1.2",
		"@effect/platform-node": "4.1.2",
		"@playwright/test": "1.59.1",
		"@types/node": "22.19.7",
		"@types/react": "19.2.9",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "5.1.2",
		"alchemy": "2.0.0-beta.85",
		"miniflare": "4.20260114.0",
		"typescript": "5.9.3",
		"vite": "7.3.1",
		"wrangler": "4.59.2"
	},
	"trustedDependencies": ["esbuild", "workerd"],
	"overrides": {
		"seroval": "~1.6.12",
		"seroval-plugins": "~1.6.12"
	}
}
