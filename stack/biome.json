{
	"$schema": "https://biomejs.dev/schemas/2.2.4/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**/src/**/*",
			"**/scripts/*.ts",
			"**/scripts/*.tsx",
			"**/vite.config.ts",
			"**/alchemy.run.ts",
			"!**/node_modules",
			"!**/src/routeTree.gen.ts"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"overrides": [
		{
			"includes": [
				"scripts/check-guard.ts",
				"scripts/check-load.ts",
				"scripts/check-release.ts"
			],
			"formatter": { "enabled": false }
		},
		{
			"includes": [
				"scripts/check-breaks.ts",
				"scripts/check-breaks-release.ts",
				"scripts/check-release.ts"
			],
			"linter": {
				"rules": { "suspicious": { "noTemplateCurlyInString": "off" } }
			}
		}
	],
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	}
}
