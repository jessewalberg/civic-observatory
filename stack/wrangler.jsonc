// LOCAL ONLY. Local Vite and Wrangler runs and the checks read this file. Never
// deploy it and never use --remote with it: the database ID is deliberately not
// a real one.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "civic-docket-local",
  "main": "./src/server.ts",
  "compatibility_date": "2026-01-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "assets": { "directory": "./dist/client", "run_worker_first": ["/robots.txt"] },
  "vars": { "APP_ENV": "local" },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "civic-docket-local",
    "database_id": "00000000-0000-0000-0000-000000000001",
    "migrations_dir": "migrations"
  }]
}
