# Local development secret references for the 1Password CLI. No secret VALUES
# live here — only op:// pointers into the civic-observatory-app / -ci vaults
# (dev env). Resolve them with `op run --env-file=.env.1password -- <cmd>` or
# `secretkit migrate`. Public bundle vars (VITE_*) are committed literals in
# .env.production / .env.example, not here.

# App vault (runtime + signing secrets)
CLERK_SECRET_KEY=op://civic-observatory-app/dev/CLERK_SECRET_KEY
CLERK_JWT_ISSUER_DOMAIN=op://civic-observatory-app/dev/CLERK_JWT_ISSUER_DOMAIN
OPENROUTER_API_KEY=op://civic-observatory-app/dev/OPENROUTER_API_KEY
STRIPE_SECRET_KEY=op://civic-observatory-app/dev/STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=op://civic-observatory-app/dev/STRIPE_WEBHOOK_SECRET
STRIPE_PRO_PRICE_ID=op://civic-observatory-app/dev/STRIPE_PRO_PRICE_ID

# CI vault (deploy bootstrap creds)
CONVEX_DEPLOY_KEY=op://civic-observatory-ci/dev/CONVEX_DEPLOY_KEY
CLOUDFLARE_API_TOKEN=op://civic-observatory-ci/dev/CLOUDFLARE_API_TOKEN
CLOUDFLARE_ACCOUNT_ID=op://civic-observatory-ci/dev/CLOUDFLARE_ACCOUNT_ID
