# Copy runtime values into ignored .dev.vars, never into a client VITE_ variable.
# node scripts/local-env.mjs generates local-only auth/webhook settings.
APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=
# Existing imported administrators remain administrators. New installations may
# claim initial ownership only with this configured, verified email.
ADMIN_EMAIL=
# External AI/email are disabled by default; never enable during local smoke.
OUTBOUND_ENABLED=false
SCHEDULED_ENABLED=true
OPENROUTER_API_KEY=
EMAIL_API_TOKEN=
EMAIL_ACCOUNT_ID=
# Test mode only. Live keys and live webhook events are rejected in code.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
